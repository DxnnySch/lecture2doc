SCADS_API_KEY=sk-your-scads-ai-key
SCADS_BASE_URL=https://llm.scads.ai/v1
SCADS_STT_MODEL=alias-stt
# The AI text steps (glossary, cleanup) automatically use the fastest of the most powerful models for every
# request. To always use one specific model instead, set it here:
# SCADS_LLM_MODEL=alias-huge-no-thinking
# SCADS_GLOSSARY_MODEL=alias-huge-no-thinking
# The models the automatic choice picks from (comma separated); default: the four strongest chat models
# SCADS_LLM_MODELS=alias-huge-no-thinking,zai-org/GLM-5.3,MiniMaxAI/MiniMax-M3,openai/gpt-oss-120b
# Cap for LLM requests per minute and model (the gateway allowed 30 per key and model); default 25
# SCADS_REQUESTS_PER_MINUTE=25
